{
  // Worker name must match the Worker connected in the Cloudflare dashboard.
  "name": "energipass",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    // Built by `npm run build`. Static files are served first.
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker handles the optional AI endpoints.
    "run_worker_first": ["/api/*"]
  }
  // Optional AI: set the secret with `npx wrangler@4 secret put ANTHROPIC_API_KEY`.
  // Without it, /api/ai/status returns { enabled: false } and the UI shows "AI belum diaktifkan".
}
